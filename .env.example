# Home-Gateway NIDS Environment Secrets Configuration Template
# Copy this file to .env and configure strong keys for production deployment.

# Environment Mode: "development" or "production"
NIDS_ENVIRONMENT=development

# Security API Keys (Must be long, high-entropy secrets in production)
NIDS_ADMIN_API_KEY=nids-prod-admin-key-change-me-immediately-38472910
NIDS_VIEWER_API_KEY=nids-prod-viewer-key-change-me-immediately-19283746
NIDS_SECRET_KEY=nids-secret-session-token-key-8374928174928174

# Database and Storage Configuration
NIDS_DB_PATH=data/nids.db
NIDS_SIEM_EXPORT_PATH=data/siem_alerts.jsonl
